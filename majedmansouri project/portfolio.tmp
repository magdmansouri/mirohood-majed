
/* Personal portfolio at the root — visually separate from shop and cafe. */
.portfolio-hero{display:grid;grid-template-columns:minmax(0,.88fr) minmax(400px,1.12fr);min-height:640px;direction:ltr}.portfolio-copy{display:flex;flex-direction:column;justify-content:center;direction:rtl;padding:clamp(2rem,6vw,6rem);background:linear-gradient(135deg,#12100e,#0a0908)}.portfolio-copy h1{margin:1rem 0;font:400 clamp(4rem,8.7vw,8.9rem)/.78 var(--serif);letter-spacing:-.06em;direction:ltr}.portfolio-copy h1 em{display:block;color:var(--gold);font-style:italic}.portfolio-copy>p{max-width:500px;color:var(--soft);font-size:.95rem;line-height:2.1}.portfolio-facts{display:grid;grid-template-columns:repeat(3,1fr);max-width:560px;margin-top:2.5rem;padding-top:1rem;border-top:1px solid var(--line);direction:ltr}.portfolio-facts div{min-width:0;padding:0 .65rem;border-left:1px solid var(--line);color:var(--muted);font:.56rem/1.6 var(--mono);overflow-wrap:anywhere}.portfolio-facts div:first-child{padding-left:0}.portfolio-facts div:last-child{border:0}.portfolio-facts b{display:block;color:var(--text);font-weight:500}.portfolio-photo{position:relative;min-height:620px;overflow:hidden;background:#112d36}.portfolio-photo:before{content:'MM';position:absolute;z-index:2;top:-.16em;left:-.08em;color:rgba(244,241,234,.13);font:500 clamp(8rem,20vw,17rem)/.7 var(--serif);letter-spacing:-.16em;pointer-events:none}.portfolio-photo:after{content:'';position:absolute;inset:0;z-index:2;background:linear-gradient(180deg,transparent 45%,rgba(10,9,8,.8)),linear-gradient(90deg,rgba(10,9,8,.25),transparent 55%)}.portfolio-photo img{width:100%;height:100%;object-fit:cover;object-position:58% center;filter:saturate(.75) contrast(1.05)}.portfolio-photo span:last-child{position:absolute;z-index:3;right:1.2rem;bottom:1rem;color:rgba(244,241,234,.75);font:.54rem/1 var(--mono);letter-spacing:.08em;direction:ltr}.portfolio-blue-line{position:absolute;z-index:4;top:15%;left:0;width:9px;height:42%;background:var(--gold)}.portfolio-grid{display:grid;grid-template-columns:180px minmax(0,1fr);gap:2.5rem}.portfolio-index{color:var(--gold);font:.65rem/1 var(--mono);letter-spacing:.1em;direction:ltr}.portfolio-index span{display:block;margin-top:.55rem;color:var(--muted);font-size:.58rem}.portfolio-title{max-width:900px;margin:-.38rem 0 1.2rem;font:400 clamp(2rem,4.25vw,4rem)/1.32 var(--serif);letter-spacing:-.055em}.portfolio-text{max-width:720px;color:var(--soft);font-size:1rem;line-height:2.15}.portfolio-approach{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(245px,.85fr);gap:3.8rem;margin-top:3rem;padding-top:1.25rem;border-top:1px solid var(--line)}.portfolio-approach>p{margin:0;color:var(--text);font:500 clamp(2.1rem,4.2vw,4.1rem)/.96 var(--serif);letter-spacing:-.055em}.portfolio-approach>p em{color:var(--gold)}.portfolio-approach ol{list-style:none;padding:0;margin:0}.portfolio-approach li{display:grid;grid-template-columns:50px 1fr;gap:1rem;padding:1.1rem 0;border-bottom:1px solid rgba(244,241,234,.08)}.portfolio-approach li b{color:var(--gold);font:.62rem/1.8 var(--mono)}.portfolio-approach h3{margin:0 0 .25rem;font-size:.9rem}.portfolio-approach span{color:var(--muted);font-size:.75rem;line-height:1.9}.portfolio-skills{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin-top:2.5rem;border-top:1px solid var(--line);border-left:1px solid var(--line)}.portfolio-skills article{min-height:195px;padding:1.3rem;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:linear-gradient(135deg,rgba(200,168,98,.07),transparent 65%)}.portfolio-skills small{color:var(--gold);font:.56rem/1 var(--mono);letter-spacing:.1em}.portfolio-skills h3{margin:1.8rem 0 .4rem;font-size:1rem}.portfolio-skills p{max-width:330px;margin:0;color:var(--muted);font-size:.75rem;line-height:1.95}.portfolio-work{overflow:hidden;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:linear-gradient(115deg,rgba(200,168,98,.08),transparent 53%),var(--panel)}.portfolio-work-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(340px,.95fr)}.portfolio-work-copy{padding:clamp(1.6rem,4vw,4.5rem) clamp(1.5rem,4vw,4.4rem) clamp(1.6rem,4vw,4.5rem) 0}.portfolio-work-label{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:3.8rem;direction:ltr}.portfolio-work-label b{font:400 clamp(2.5rem,5vw,5.1rem)/.8 var(--serif);letter-spacing:-.1em}.portfolio-work-label span{color:var(--gold);font:.58rem/1.55 var(--mono);letter-spacing:.1em;text-align:right}.portfolio-work-copy h2{max-width:650px;margin:0;font-size:clamp(1.58rem,3vw,2.7rem);line-height:1.5}.portfolio-work-copy p{max-width:590px;margin:1rem 0;color:var(--soft);font-size:.88rem;line-height:2.05}.portfolio-work-copy ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem;margin:1.8rem 0;padding:0;list-style:none}.portfolio-work-copy li{color:#d3d9d9;font-size:.74rem;line-height:1.8}.portfolio-work-copy li:before{content:'—';color:var(--gold);margin-left:.4rem}.portfolio-work-art{position:relative;min-height:520px;overflow:hidden;background:#112d36}.portfolio-work-art:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent,rgba(10,9,8,.84))}.portfolio-work-art img{width:100%;height:100%;object-fit:cover;filter:grayscale(.3) saturate(.75)}.portfolio-work-art div{position:absolute;z-index:2;right:2rem;bottom:2rem;color:var(--text);font:500 clamp(4rem,9vw,8.4rem)/.69 var(--serif);letter-spacing:-.11em;direction:ltr;writing-mode:vertical-rl}.portfolio-work-art span{color:var(--gold);font-style:italic}.portfolio-contact{position:relative;overflow:hidden;display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:1.5rem;align-items:center;padding:clamp(1.6rem,4vw,4rem);background:#112d36;border-top:1px solid rgba(200,168,98,.4);border-bottom:1px solid rgba(200,168,98,.2)}.portfolio-contact:after{content:'M';position:absolute;left:-.05em;bottom:-.37em;color:rgba(200,168,98,.11);font:500 16rem/.7 var(--serif);pointer-events:none}.portfolio-contact>div{position:relative;z-index:1}.portfolio-contact h2{max-width:670px;margin:.7rem 0 0;font-size:clamp(1.75rem,3.7vw,3.25rem);line-height:1.36}.portfolio-contact p{color:var(--soft);font-size:.87rem}.portfolio-contact-links{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:.55rem}.site-qr{display:grid;place-items:center;gap:.3rem;padding:.45rem;background:var(--text);color:#0a0908;font-size:.54rem}.site-qr img{width:82px;height:82px}@media(max-width:900px){.portfolio-hero{grid-template-columns:1fr}.portfolio-photo{min-height:420px;order:-1}.portfolio-grid{grid-template-columns:135px minmax(0,1fr)}.portfolio-work-grid{grid-template-columns:1fr}.portfolio-work-copy{padding-left:0}.portfolio-work-art{min-height:390px}.portfolio-work-art div{writing-mode:horizontal-tb;top:2rem;right:2rem;bottom:auto}}@media(max-width:650px){.portfolio-hero{display:flex;flex-direction:column;min-height:auto}.portfolio-copy{order:2;padding:2rem 0}.portfolio-photo{order:1;width:100%;min-height:480px}.portfolio-copy h1{font-size:4.1rem}.portfolio-copy h1 em{font-size:4.4rem}.portfolio-grid{display:block}.portfolio-index{margin-bottom:1rem}.portfolio-title{margin:0 0 .9rem;font-size:1.75rem;line-height:1.55}.portfolio-text{font-size:.86rem;line-height:2.12}.portfolio-approach{grid-template-columns:1fr;gap:2.2rem;margin-top:2rem}.portfolio-approach>p{font-size:2.35rem}.portfolio-approach li{grid-template-columns:42px 1fr}.portfolio-skills{grid-template-columns:1fr;margin-top:1.5rem}.portfolio-skills article{min-height:145px;padding:1rem 1.1rem}.portfolio-skills h3{margin:.85rem 0 .35rem}.portfolio-work-copy{padding:1.5rem 1rem}.portfolio-work-label{margin-bottom:2.3rem}.portfolio-work-label b{font-size:3rem}.portfolio-work-copy h2{font-size:1.5rem;line-height:1.6}.portfolio-work-copy ul{grid-template-columns:1fr;gap:.52rem;margin:1.35rem 0}.portfolio-work-art{min-height:315px}.portfolio-work-art div{top:1.55rem;right:1.2rem;font-size:4.5rem}.portfolio-contact{grid-template-columns:1fr;gap:1.25rem;padding:1.55rem 1rem}.portfolio-contact h2{font-size:1.58rem;line-height:1.58}.portfolio-contact-links{justify-content:flex-start}.site-qr{justify-self:start}}
